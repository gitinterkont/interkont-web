@media (prefers-reduced-motion:reduce){*{animation:none;transition:none}.rv{opacity:1;transform:none}}

/* === Gradiente de marca === */
:root{ --grad:linear-gradient(92deg,var(--g1) 0%,var(--g2) 100%); --grad-r:linear-gradient(120deg,var(--g1) 0%,var(--g2) 100%); }
.btn-mag{background:var(--grad)!important}
.btn-mag:hover{box-shadow:0 16px 34px -10px color-mix(in srgb, var(--g1) 55%, transparent)!important}
.eyebrow{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .eyebrow{background:none;-webkit-text-fill-color:initial;color:var(--g2)}
.hero .eyebrow::before{background:linear-gradient(90deg,var(--g1),var(--g2))}

.func .fi,.drop .di,.node .ni{background:var(--grad)!important;color:#fff!important}
.eye-caps .ei{background:var(--grad)!important;color:#fff!important}
.core{background:var(--grad-r)!important;box-shadow:0 20px 44px -14px color-mix(in srgb, var(--g1) 60%, transparent)!important}
.core::after{border-color:color-mix(in srgb, var(--g2) 50%, transparent)!important}
.stat-band::before,.eye::before{background:radial-gradient(circle,color-mix(in srgb, var(--g2) 36%, transparent),color-mix(in srgb, var(--g1) 36%, transparent) 45%,transparent 68%)!important}
.scan .line{background:linear-gradient(90deg,transparent,var(--g2),var(--g1),transparent)!important;box-shadow:0 0 16px color-mix(in srgb, var(--g2) 80%, transparent)!important}
.box{border-color:var(--g2)!important} .box .bl{background:var(--grad)!important}
.mbar span.hot,.mrow .pin,.mock-top .d:nth-child(1){background:var(--grad)!important}
.ux{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative}
.ux::before{content:""; position:absolute; inset:0; background:none; pointer-events:none}
.ux-txt,.ux-vis{position:relative; z-index:2}
.ux-vis{background:none!important}
footer{border-radius:0!important; margin:0!important; max-width:none!important; width:100%!important; padding:clamp(72px,9vw,120px) clamp(28px,4vw,56px) 44px!important; min-height:clamp(420px,44vw,560px)!important; display:flex!important; flex-direction:column!important; justify-content:space-between!important; background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative}
footer::before{content:""; position:absolute; inset:0; border-radius:inherit; background:none; pointer-events:none}
.fgrid,.fbot{position:relative; z-index:2}
.ac .ico{color:var(--g2)}
.hero-bg{background:#0b0910 var(--herobg) center/cover no-repeat!important}
.sb .n .u{color:var(--g2)!important}
.btn-dark:hover{box-shadow:0 14px 30px -10px color-mix(in srgb, var(--g1) 45%, transparent)!important}
.partners .names span{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent} .partners .names{opacity:.85}

.stat-band{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative; overflow:hidden}
.stat-band::before{content:""!important; position:absolute!important; inset:0!important; width:auto!important; height:auto!important; right:auto!important; bottom:auto!important; filter:none!important; border-radius:inherit; background:none!important; z-index:0}
.eye{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative; overflow:hidden}
.eye::after{content:""; position:absolute; inset:0; border-radius:inherit; background:none; pointer-events:none; z-index:0}
.eye>div,.eye>.scan{position:relative; z-index:1}

/* Parallax fiable: sin transform en los contenedores con imagen */
.ux,footer,.stat-band,.eye{transform:none!important; animation-name:rv-fade!important; backdrop-filter:none!important; -webkit-backdrop-filter:none!important}
.ux,footer,.stat-band,.eye{background-attachment:fixed!important; background-size:cover!important; background-position:center center!important; background-repeat:no-repeat!important}
@keyframes rv-fade{from{opacity:0} to{opacity:1}}
.ux:hover,footer:hover,.stat-band:hover,.eye:hover{transform:none!important}
.ux > *,footer > *,.stat-band > *,.eye > *{position:relative; z-index:2}

/* Cursor personalizado con estela difuminada */
@media (hover:hover) and (pointer:fine){
  html,body{cursor:none}
  a,button,.tab,.tabrail button,.bfilters button,input,textarea,select,[role="button"]{cursor:none}
  #ikcur,#ikblur{position:fixed; top:0; left:0; pointer-events:none; z-index:9999; will-change:transform; opacity:0}
  body.ikready #ikcur{opacity:1}
  body.ikready #ikblur{opacity:.85}
  #ikcur{width:9px;height:9px;border-radius:50%;background:var(--grad);margin:-4.5px 0 0 -4.5px;transition:width .22s,height .22s,margin .22s,opacity .3s}
  #ikblur{width:52px;height:52px;border-radius:50%;margin:-26px 0 0 -26px;background:radial-gradient(circle,color-mix(in srgb, var(--g1) 50%, transparent),color-mix(in srgb, var(--g2) 34%, transparent) 55%,transparent 72%);filter:blur(11px);transition:width .3s,height .3s,margin .3s,opacity .3s}
  body.ikhot #ikcur{width:0;height:0;margin:0}
