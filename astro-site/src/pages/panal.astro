.partners .names span{font-weight:800; font-size:18px; white-space:nowrap}
/* Carrusel infinito de clientes — banda oscura de ancho completo */
.partners{display:block!important; padding:0!important; border:none!important; margin:0 0 clamp(56px,7vw,100px)!important; width:100%}
.mband>.l{display:block; font-size:12px; font-weight:800; letter-spacing:.11em; text-transform:uppercase; color:rgba(255,255,255,.45); max-width:none; text-align:center; margin-bottom:26px}
.mband{position:relative; width:100%; margin:0; max-width:none; background:#0b0910; padding:clamp(38px,5vw,60px) 0; overflow:hidden}
