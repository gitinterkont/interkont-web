.mock-top .d{width:9px;height:9px;border-radius:50%;background:#E1DEE6} .mock-top .d:nth-child(1){background:var(--mag)}
.mock-top .t{margin-left:8px;font-size:12px;font-weight:700;color:var(--ink-soft)}
