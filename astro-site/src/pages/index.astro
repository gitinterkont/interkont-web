/* ============ Capa de interacción ============ */
@media (prefers-reduced-motion:no-preference){

  /* --- Tarjetas claras: elevación con curva suave --- */
  .card.lite,.prod.lite,.func,.fcard,.agent,.bcard,.step,.invc.lite,.svcx,.acard,.mv-card,.iad-item,.model,.plan,.kpibox,.sc{
    transition:transform .45s cubic-bezier(.2,.7,.3,1), box-shadow .45s cubic-bezier(.2,.7,.3,1), background .3s !important}
  .card.lite:hover,.prod.lite:hover,.func:hover,.fcard:hover,.agent:hover,.bcard:hover,.step:hover,.invc.lite:hover,.svcx:hover{
    transform:translateY(-8px) !important}

  /* --- Tile de icono: reacciona al hover de la tarjeta --- */
  .cico,.fi,.ai,.bi,.ii,.ni,.p-badge,.si,.mv-ico,.chip-live,.di{
    transition:transform .45s cubic-bezier(.2,.7,.3,1), box-shadow .35s, border-radius .35s}
  .card:hover .cico,.func:hover .fi,.agent:hover .ai,.bcard:hover .bi,.iad-item:hover .ii,
  .fcard:hover .fi,.mv-card:hover .mv-ico,.sc:hover .si{
    transform:scale(1.09) rotate(-4deg); border-radius:50%;
    box-shadow:0 14px 28px -12px color-mix(in srgb, var(--g1) 55%, transparent)}

  /* --- Icono interno: micro-rebote --- */
  .cico .ico,.fi .ico,.ai .ico,.bi .ico,.ii .ico,.mv-ico .ico,.si .ico{transition:transform .4s cubic-bezier(.34,1.56,.64,1)}
  .card:hover .cico .ico,.func:hover .fi .ico,.agent:hover .ai .ico,.bcard:hover .bi .ico,
  .iad-item:hover .ii .ico,.mv-card:hover .mv-ico .ico,.sc:hover .si .ico{transform:scale(1.14)}

  /* --- Titulares: pasan al degradado de marca --- */
  .func h4,.agent h4,.bcard h3,.step h4,.iad-item h4,.fcard h4{transition:color .35s}
  .func:hover h4,.agent:hover h4,.bcard:hover h3,.step:hover h4,.fcard:hover h4{
    background-image:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent}

  /* --- Borde vivo en tarjetas claras --- */
  .func,.agent,.bcard,.step,.fcard,.svcx{position:relative}
  .func::after,.agent::after,.bcard::after,.step::after,.svcx::after{
    content:""; position:absolute; inset:0; border-radius:inherit; pointer-events:none;
    box-shadow:inset 0 0 0 1.5px transparent; transition:box-shadow .45s}
  .func:hover::after,.agent:hover::after,.bcard:hover::after,.step:hover::after,.svcx:hover::after{
    box-shadow:inset 0 0 0 1.5px color-mix(in srgb, var(--g1) 28%, transparent)}

  /* --- Contenedores con parallax: sin transform, brillo y borde --- */
  .card.dk,.prod.dk,.invc.dk,.agent.count,.model.dk,.plan.hot,.fcard.tier.hot,.iad-item,.mv-card{
    transition:box-shadow .45s, filter .45s !important}
  .card.dk:hover,.prod.dk:hover,.invc.dk:hover,.agent.count:hover,.model.dk:hover,.plan.hot:hover,.fcard.tier.hot:hover{
    filter:brightness(1.09) saturate(1.06);
    box-shadow:var(--sh-lg), inset 0 0 0 1.5px color-mix(in srgb, var(--g2) 40%, transparent) !important}
  .mv-card:hover,.iad-item:hover{box-shadow:inset 0 0 0 1.5px color-mix(in srgb, var(--g2) 38%, transparent), var(--sh-lg) !important}

  /* --- Chips, píldoras y etiquetas --- */
  .pchip,.mv-vals li,.srcs span,.ac,.pcard-wrap .p-sub,.partners .names span{transition:transform .3s cubic-bezier(.2,.7,.3,1), box-shadow .3s, color .3s}
  .pchip:hover,.mv-vals li:hover,.srcs span:hover,.ac:hover{transform:translateY(-3px)}
  .partners .names span:hover{transform:translateY(-2px) scale(1.03)}

  /* --- Listas de verificación --- */
  .chk li,.eye-caps li,.speclist li{transition:transform .3s cubic-bezier(.2,.7,.3,1)}
  .chk li:hover,.eye-caps li:hover,.speclist li:hover{transform:translateX(4px)}
  .eye-caps .ei{transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .3s}
  .eye-caps li:hover .ei{transform:scale(1.1) rotate(-5deg); box-shadow:0 12px 24px -12px color-mix(in srgb, var(--g2) 60%, transparent)}

  /* --- Rail de pestañas y filtros --- */
  .tabrail button,.bfilters button,.tab{transition:transform .3s cubic-bezier(.2,.7,.3,1), box-shadow .3s, color .25s, background .3s}
  .tabrail button:not(.on):hover,.bfilters button:not(.on):hover{transform:translateX(4px)}
  .tabrail button .ti{transition:transform .35s cubic-bezier(.34,1.56,.64,1)}
  .tabrail button:hover .ti{transform:scale(1.08) rotate(-5deg)}

  /* --- Enlaces con flecha --- */
  .more,.bfeat .more{transition:gap .3s cubic-bezier(.2,.7,.3,1)}
  .more:hover,.bfeat .more:hover{gap:15px}

  /* --- Paneles del tablero --- */
  .pz{transition:box-shadow .45s}
  .pz:hover{box-shadow:0 12px 28px rgba(19,17,23,.1), 0 50px 90px -34px color-mix(in srgb, var(--g1) 40%, transparent) !important}
  .alert{transition:transform .3s cubic-bezier(.2,.7,.3,1)}
  .alert:hover{transform:translateX(5px)}

  /* --- Burbujas de chat --- */
  .msg{transition:transform .35s cubic-bezier(.2,.7,.3,1), box-shadow .35s}
  .msg.q:hover{transform:translateX(-5px); box-shadow:0 12px 26px -12px color-mix(in srgb, var(--g1) 50%, transparent)}
  .msg.a:hover{transform:translateX(5px)}

  /* --- Enlaces del menú desplegable --- */
  .drop a{transition:background .25s, transform .3s cubic-bezier(.2,.7,.3,1)}
  .drop a:hover{transform:translateX(4px)}
  .drop a:hover .di{transform:scale(1.08) rotate(-5deg)}

  /* --- Enlaces del footer --- */
  .fcol a{transition:color .25s, transform .3s cubic-bezier(.2,.7,.3,1); display:block}
  .fcol a:hover{transform:translateX(5px)}
}

/* ============ Aparición al hacer scroll ============ */
@supports (animation-timeline: view()){
@media (prefers-reduced-motion:no-preference){

  @keyframes ap-up{from{opacity:0; transform:translateY(38px)} to{opacity:1; transform:none}}
  @keyframes ap-in{from{opacity:0} to{opacity:1}}
  @keyframes ap-left{from{opacity:0; transform:translateX(-34px)} to{opacity:1; transform:none}}
  @keyframes ap-right{from{opacity:0; transform:translateX(34px)} to{opacity:1; transform:none}}
  @keyframes ap-scale{from{opacity:0; transform:scale(.94)} to{opacity:1; transform:none}}

  /* --- Titulares y bloques de encabezado --- */
  .sec-head,.func-head,.dash-head,.mv-head,.iad-head,.split>div,.sb-head{
    animation:ap-up .85s cubic-bezier(.2,.7,.3,1) forwards;
    animation-timeline:view(); animation-range:entry 0% entry 92%}

  /* --- Tarjetas y bloques de contenido --- */
  .card,.prod,.func,.fcard,.agent,.bcard,.step,.invc,.svcx,.iad-item,.mv-card,
  .model,.plan,.kpibox,.sc,.pcard-wrap,.abody,.acard,.acta,.partners,.stat-band,
  .eye,.ux,.bfeat,.news,.chat,.orbit,.tool>div,.prods>div,.cards>div{
    animation:ap-up .9s cubic-bezier(.2,.7,.3,1) forwards;
    animation-timeline:view(); animation-range:entry 0% entry 88%}

  /* --- Escalonado por columna en grillas --- */
  .funcs>*:nth-child(3n+2),.agents>*:nth-child(4n+2),.cards>*:nth-child(3n+2),
  .feat>*:nth-child(2n),.steps>*:nth-child(3n+2),.iad-grid>*:nth-child(3n+2),
  .bgrid>*:nth-child(3n+2),.svc>*:nth-child(3n+2){animation-range:entry 0% entry 100%}
  .funcs>*:nth-child(3n),.agents>*:nth-child(4n),.cards>*:nth-child(3n),
  .steps>*:nth-child(3n),.iad-grid>*:nth-child(3n),.bgrid>*:nth-child(3n),
  .svc>*:nth-child(3n){animation-range:entry 0% entry 112%}
  .agents>*:nth-child(4n+3){animation-range:entry 0% entry 106%}

  /* --- Entradas laterales en bloques a dos columnas --- */
  .eye>div:first-child,.ux-txt{animation-name:ap-left}
  .eye>.scan,.ux-vis{animation-name:ap-right}
  .ceo-card{animation-name:ap-left} .ceo-quote{animation-name:ap-right}

  /* --- Elementos que no pueden transformarse (parallax) --- */
  .stat-band,.eye,.ux,.bfeat,.news,.iad,.mv-band,.agent.count,.invc.dk,
  .model.dk,.plan.hot,.fcard.tier.hot,.card.dk,.prod.dk,.ceo-card,.pull,.acta,footer{
    animation-name:ap-in !important}

  /* --- Listas y detalles --- */
  .chk li,.eye-caps li,.speclist li,.mv-vals li,.srcs span,.pchip,.alerts .alert{
    animation:ap-up .7s cubic-bezier(.2,.7,.3,1) forwards;
    animation-timeline:view(); animation-range:entry 0% entry 96%}
  .chk li:nth-child(even),.eye-caps li:nth-child(even),.speclist li:nth-child(even){
    animation-range:entry 0% entry 110%}

  /* --- Burbujas de chat, escalonadas --- */
  .msg{animation:ap-scale .7s cubic-bezier(.34,1.56,.64,1) forwards; animation-timeline:view(); animation-range:entry 0% entry 94%}
  .msg:nth-child(2){animation-range:entry 0% entry 104%}
  .msg:nth-child(3){animation-range:entry 0% entry 114%}
  .msg:nth-child(4){animation-range:entry 0% entry 124%}

  /* --- CTA de cierre y footer --- */
  .final>div,.iad-cta,.final-cta{animation:ap-up .9s cubic-bezier(.2,.7,.3,1) forwards; animation-timeline:view(); animation-range:entry 0% entry 90%}
  .fgrid>div{animation:ap-up .8s cubic-bezier(.2,.7,.3,1) forwards; animation-timeline:view(); animation-range:entry 0% cover 30%}
  .fgrid>div:nth-child(2){animation-range:entry 0% cover 38%}
  .fgrid>div:nth-child(3){animation-range:entry 0% cover 46%}
  .fgrid>div:nth-child(4){animation-range:entry 0% cover 54%}

  /* --- El hero no se anima (ya es visible al cargar) --- */
  .hero,.hero *{animation-name:none !important}
}}
/* Red de seguridad de impresión */
@media print{ *{animation:none!important; opacity:1!important; transform:none!important; visibility:visible!important} }

/* ===== Tema morado: solo variables ===== */
body.tp{
  --mag:#9A69DB; --mag-lt:#C4A0EE; --mag-tint:#F0E9FA;
  --g1:#6E3BB5; --g2:#B98CE8; --bgimg:url("/assets/rectangle-943.png");
  --grad:linear-gradient(92deg,var(--g1) 0%,var(--g2) 100%);
  --grad-r:linear-gradient(120deg,var(--g1) 0%,var(--g2) 100%);
}
body.tp .hero video{filter:grayscale(1) sepia(1) saturate(3.4) hue-rotate(212deg) brightness(.78) contrast(1.05)}
#ik-color path:not([fill="#121212"]){fill:var(--mag)}
#dl stop:first-child,#gg stop:first-child,#dg stop:first-child{stop-color:var(--g1)}
#dl stop:last-child,#gg stop:last-child,#dg stop:nth-child(2),#dg stop:last-child{stop-color:var(--g2)}

/* Selector de tema */
.thm{display:none !important; align-items:center; gap:6px; background:rgba(255,255,255,.12); box-shadow:inset 0 0 0 1px rgba(255,255,255,.22);
  border:none; cursor:pointer; padding:6px; border-radius:100px; transition:transform .3s, background .3s; margin-left:4px}
header.scrolled .thm{background:rgba(19,17,23,.06); box-shadow:inset 0 0 0 1px rgba(19,17,23,.1)}
.thm .sw{width:18px; height:18px; border-radius:50%; display:block; outline:2px solid transparent}
.thm .sw-a{background:linear-gradient(120deg,#E70147,#FFAA4A)}
.thm .sw-b{background:linear-gradient(120deg,#6E3BB5,#B98CE8)}
#thm[data-theme="original"] .sw-a{outline-color:#fff}
#thm[data-theme="purple"] .sw-b{outline-color:#fff}
header.scrolled #thm[data-theme="original"] .sw-a{outline-color:#131117}
header.scrolled #thm[data-theme="purple"] .sw-b{outline-color:#131117}
.thm:hover{transform:scale(1.06)}
html.notrans *,html.notrans *::before,html.notrans *::after{transition:none !important}
@media (max-width:960px){ .thm{margin:0 10px 0 auto} }
body{overflow-x:clip}

/* Logos del carrusel: tamaño consciente de la proporción */
.mset img{height:auto!important; max-height:clamp(34px,3.4vw,52px); width:auto; max-width:clamp(120px,13vw,190px); min-width:clamp(58px,6vw,84px); object-fit:contain}
.mset img[src*="image4"]{max-height:clamp(58px,5.6vw,84px); min-width:0}

/* ===== Botón flotante de WhatsApp ===== */
.wa-fab{position:fixed; right:clamp(16px,2.4vw,30px); bottom:clamp(16px,2.4vw,30px); z-index:70;
  width:60px; height:60px; border-radius:50%; display:grid; place-items:center; color:#fff!important;
  background:linear-gradient(135deg,#25D366,#128C7E);
  box-shadow:0 12px 30px -8px rgba(18,140,126,.7), 0 0 0 0 rgba(37,211,102,.5);
  transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s; animation:wapulse 2.6s ease-out infinite}
.wa-fab .ico{width:30px;height:30px; fill:currentColor; stroke:none}
.wa-fab:hover{transform:scale(1.09) translateY(-3px); color:#fff!important;
  box-shadow:0 18px 40px -10px rgba(18,140,126,.85)}
@keyframes wapulse{0%{box-shadow:0 12px 30px -8px rgba(18,140,126,.7), 0 0 0 0 rgba(37,211,102,.55)}
  70%{box-shadow:0 12px 30px -8px rgba(18,140,126,.7), 0 0 0 18px rgba(37,211,102,0)}
  100%{box-shadow:0 12px 30px -8px rgba(18,140,126,.7), 0 0 0 0 rgba(37,211,102,0)}}
.wa-fab .tip{position:absolute; right:calc(100% + 12px); white-space:nowrap; font-size:13.5px; font-weight:700; color:var(--ink);
