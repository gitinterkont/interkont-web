.awards{position:relative; overflow:hidden; border-radius:var(--r-xl); margin:clamp(40px,5vw,68px) 0 clamp(26px,3.2vw,40px); padding:clamp(34px,4.4vw,60px); color:#fff; box-shadow:var(--sh-lg);
