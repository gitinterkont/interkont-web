    width:42px; height:42px; margin:-21px 0 0 -21px; border-radius:50%;
    border:1.5px solid var(--mag); transition:width .3s cubic-bezier(.2,.7,.3,1), height .3s cubic-bezier(.2,.7,.3,1), margin .3s cubic-bezier(.2,.7,.3,1), background .3s, backdrop-filter .3s, opacity .3s}
  #ikblur{width:0!important;height:0!important;margin:0!important;opacity:0!important}
  body.ikhot #ikcur{width:6px;height:6px;margin:-3px 0 0 -3px}
  body.ikhot #ikring{width:86px;height:86px;margin:-43px 0 0 -43px;border-color:var(--mag-lt);
    background:radial-gradient(circle,color-mix(in srgb, var(--g1) 10%, transparent),color-mix(in srgb, var(--g2) 6%, transparent) 60%,transparent 72%);
    -webkit-backdrop-filter:blur(6px) saturate(1.15); backdrop-filter:blur(6px) saturate(1.15)}
