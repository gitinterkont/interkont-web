.btn-mag:hover{box-shadow:0 16px 34px -10px color-mix(in srgb, var(--g1) 55%, transparent)!important}
.eyebrow{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero .eyebrow{background:none;-webkit-text-fill-color:initial;color:var(--g2)}
.hero .eyebrow::before{background:linear-gradient(90deg,var(--g1),var(--g2))}

.card .cico,.chip-live,.iad-item .ii,.drop .di{background:var(--grad)!important;color:#fff!important}
.card.dk .cico{background:var(--grad)!important;color:#fff!important}
.prod:hover .more .circ{background:var(--grad)!important;box-shadow:none!important;color:#fff}
.card .prog span{background:linear-gradient(0deg,color-mix(in srgb, var(--g1) 25%, transparent),color-mix(in srgb, var(--g2) 45%, transparent))!important}
.pvis-row span{background:linear-gradient(0deg,color-mix(in srgb, var(--g1) 22%, transparent),color-mix(in srgb, var(--g2) 42%, transparent))!important}
.prod.dk .pvis-row span{background:linear-gradient(0deg,color-mix(in srgb, var(--g1) 45%, transparent),color-mix(in srgb, var(--g2) 55%, transparent))!important}
.iad{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important}
.iad::before{background:none!important; position:absolute!important; inset:0!important; width:auto!important; height:auto!important; right:auto!important; top:auto!important; filter:none!important}
.iad-item{background:rgba(255,255,255,.07)!important; -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px); box-shadow:inset 0 0 0 1px rgba(255,255,255,.1)}
footer{border-radius:0!important; margin:0!important; max-width:none!important; width:100%!important; padding:clamp(72px,9vw,120px) clamp(28px,4vw,56px) 44px!important; min-height:clamp(420px,44vw,560px)!important; display:flex!important; flex-direction:column!important; justify-content:space-between!important; background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative}
footer::before{content:""; position:absolute; inset:0; border-radius:inherit; background:none; pointer-events:none}
.fgrid,.fbot{position:relative; z-index:2}
.more .circ{background:var(--grad); color:#fff; box-shadow:none!important}
.prod.dk .more .circ{box-shadow:none!important}
.card.dk .cico{color:#fff!important}
.partners .names span{background:var(--grad); -webkit-background-clip:text; background-clip:text; color:transparent; opacity:1}
.partners{opacity:1} .partners .names{opacity:.85}
.btn-dark:hover{box-shadow:0 14px 30px -10px color-mix(in srgb, var(--g1) 45%, transparent)!important}
.hero-bg{background:radial-gradient(120% 120% at 15% 20%,color-mix(in srgb, var(--g1) 30%, transparent),color-mix(in srgb, var(--g2) 14%, transparent) 38%,transparent 60%),repeating-linear-gradient(115deg,#17131d 0 22px,#120f18 22px 44px)!important}
.gauge circle:last-of-type{stroke:var(--g1)!important}
.live .pt{background:var(--g1)!important}
.tab.on::after{background:var(--grad)!important}
.prog-mini span:nth-child(3){background:var(--grad)!important}

/* Parallax en tarjetas y contenedores oscuros */
.card.dk{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative; overflow:hidden}
.card.dk::before{content:""; position:absolute; inset:0; border-radius:inherit; background:none; pointer-events:none; z-index:0}
.card.dk>*{position:relative; z-index:1}
.prod.dk{background:#0b0910!important; background-image:var(--bgimg)!important; background-size:cover!important; background-position:center!important; background-attachment:fixed!important; position:relative}
.prod.dk::after{content:""; position:absolute; inset:0; border-radius:inherit; background:none; pointer-events:none; z-index:0}
.prod.dk>*{position:relative; z-index:1}
.mv-card.dk{background:rgba(255,255,255,.07)!important; background-image:none!important}

/* Parallax fiable: sin transform en los contenedores con imagen */
.iad,.mv-band,footer,.card.dk,.prod.dk{transform:none!important; animation-name:rv-fade!important; backdrop-filter:none!important; -webkit-backdrop-filter:none!important}
.iad,.mv-band,footer,.card.dk,.prod.dk{background-attachment:fixed!important; background-size:cover!important; background-position:center center!important; background-repeat:no-repeat!important}
@keyframes rv-fade{from{opacity:0} to{opacity:1}}
.iad:hover,.mv-band:hover,footer:hover,.card.dk:hover,.prod.dk:hover{transform:none!important}
.iad > *,.mv-band > *,footer > *,.card.dk > *,.prod.dk > *{position:relative; z-index:2}

/* Cursor personalizado con estela difuminada */
@media (hover:hover) and (pointer:fine){
  html,body{cursor:none}
  a,button,.tab,.tabrail button,.bfilters button,input,textarea,select,[role="button"]{cursor:none}
  #ikcur,#ikblur{position:fixed; top:0; left:0; pointer-events:none; z-index:9999; will-change:transform; opacity:0}
  body.ikready #ikcur{opacity:1}
  body.ikready #ikblur{opacity:.85}
  #ikcur{width:9px;height:9px;border-radius:50%;background:var(--grad);margin:-4.5px 0 0 -4.5px;transition:width .22s,height .22s,margin .22s,opacity .3s}
  #ikblur{width:52px;height:52px;border-radius:50%;margin:-26px 0 0 -26px;background:radial-gradient(circle,color-mix(in srgb, var(--g1) 50%, transparent),color-mix(in srgb, var(--g2) 34%, transparent) 55%,transparent 72%);filter:blur(11px);transition:width .3s,height .3s,margin .3s,opacity .3s}
  body.ikhot #ikcur{width:0;height:0;margin:0}
  body.ikhot #ikblur{width:82px;height:82px;margin:-41px 0 0 -41px;opacity:1}
  body.ikready.ikmove #ikblur{opacity:1}
}
@media (prefers-reduced-motion:reduce){ html,body,a,button{cursor:auto!important} #ikcur,#ikblur{display:none!important} }

