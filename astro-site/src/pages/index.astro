.cx-kpis .l{font-size:11px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:rgba(255,255,255,.55); margin-top:8px; max-width:14ch; line-height:1.35}
.cxs-bar{position:relative; z-index:3; display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
  padding:20px clamp(30px,4vw,58px) clamp(26px,3vw,36px)}
