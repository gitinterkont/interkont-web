.cx-kpis{display:flex; gap:clamp(20px,3vw,44px); flex-wrap:wrap; margin-top:clamp(22px,3vw,32px); padding-top:22px; border-top:1px solid rgba(255,255,255,.16)}
.cx-kpis .n{font-size:clamp(24px,2.8vw,36px); font-weight:900; letter-spacing:-.04em; line-height:1; color:#fff}
