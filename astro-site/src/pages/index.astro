/* ===== Hover: header y contenidos ===== */
@media (hover:hover) and (pointer:fine){

  /* --- Enlaces del nav: subrayado que crece desde el centro --- */
  header nav>a,.nav-dropbtn{position:relative}
  header nav>a::after,.nav-dropbtn::after{content:""; position:absolute; left:50%; right:50%; bottom:-6px; height:2px;
    background:var(--grad); border-radius:2px; transition:left .32s cubic-bezier(.2,.7,.3,1), right .32s cubic-bezier(.2,.7,.3,1)}
  header nav>a:hover::after,.nav-drop:hover .nav-dropbtn::after{left:0; right:0}
  header nav>a.btn::after{display:none}

  /* --- Logo --- */
  .logo{transition:transform .38s cubic-bezier(.34,1.56,.64,1); display:inline-block}
  .logo:hover{transform:scale(1.045)}

  /* --- La píldora del header reacciona --- */
  header .hbar::before{transition:box-shadow .4s, background .35s}
  header .hbar:hover::before{box-shadow:inset 0 0 0 1px rgba(255,170,74,.34), 0 22px 46px -22px rgba(0,0,0,.75)}
  header.scrolled .hbar:hover::before{box-shadow:inset 0 0 0 1px rgba(231,1,71,.2), 0 20px 44px -22px rgba(19,17,23,.45)}

  /* --- Botón del header --- */
  header nav .btn-dark{transition:transform .3s cubic-bezier(.2,.7,.3,1), box-shadow .35s, background .3s}
  header nav .btn-dark:hover{background:var(--grad); transform:translateY(-2px); box-shadow:0 14px 30px -10px rgba(231,1,71,.6)}

  /* --- Párrafos y bloques de texto: aclarado sutil --- */
  .big,.func p,.agent p,.step p,.bcard p,.cs p,.mv-card p,.iad-item p{transition:color .35s}
  .func:hover p,.agent:hover p,.step:hover p,.bcard:hover p{color:var(--ink)}

  /* --- Titulares de sección: barra de acento --- */
  .func-head>div:first-child,.sec-head{position:relative}
  .func-head>div:first-child::before,.sec-head::before{content:""; position:absolute; left:-18px; top:6px; bottom:6px; width:3px;
    border-radius:3px; background:var(--grad); opacity:0; transform:scaleY(.4); transform-origin:top;
    transition:opacity .4s, transform .5s cubic-bezier(.2,.7,.3,1)}
  .func-head:hover>div:first-child::before,.sec-head:hover::before{opacity:1; transform:scaleY(1)}

  /* --- Imágenes y logos --- */
  .cx-logo img,.tst .foot img{transition:transform .4s cubic-bezier(.2,.7,.3,1), opacity .35s}
  .cx:hover .cx-logo img{transform:scale(1.04)}
  .tst:hover .foot img{opacity:1; transform:scale(1.05)}
  .mset img{transition:opacity .35s, transform .35s cubic-bezier(.34,1.56,.64,1)}
  .mset img:hover{opacity:1; transform:scale(1.12)}

  /* --- Reconocimientos --- */
  .aw{transition:transform .45s cubic-bezier(.2,.7,.3,1), box-shadow .45s, background .35s}
  .aw:hover{transform:translateY(-6px)}
  .aw .awi{transition:transform .42s cubic-bezier(.34,1.56,.64,1), border-radius .35s}
  .aw:hover .awi{transform:scale(1.09) rotate(-5deg); border-radius:50%}

  /* --- Hitos de trayectoria --- */
  .tr{transition:transform .45s cubic-bezier(.2,.7,.3,1), box-shadow .45s}
  .tr:hover{transform:translateY(-6px)}
  .tr .yr,.trj .yr{transition:letter-spacing .35s}
  .tr:hover .yr{letter-spacing:.13em}

  /* --- Slider de casos --- */
  .cx-dot{transition:transform .3s cubic-bezier(.34,1.56,.64,1), background .3s, width .35s}
  .cx-dot:hover{transform:scale(1.35)}
  .cx-nav button{transition:transform .32s cubic-bezier(.2,.7,.3,1), background .3s, box-shadow .3s}
  .cx-nav button:hover{transform:scale(1.09)}

  /* --- KPIs y cifras --- */
  .cs-kpis>div,.sb,.kpi,.metric{transition:transform .38s cubic-bezier(.2,.7,.3,1)}
  .cs-kpis>div:hover,.sb:hover,.metric:hover{transform:translateY(-4px)}

  /* --- Testimonios --- */
  .tst blockquote{transition:color .35s}
  .tst .qm{transition:transform .42s cubic-bezier(.34,1.56,.64,1)}
  .tst:hover .qm{transform:translateY(-3px) scale(1.08)}

  /* --- Botones en general: brillo que barre --- */
  .btn{position:relative; overflow:hidden}
  .btn::before{content:""; position:absolute; inset:0;
    background:linear-gradient(105deg,transparent 30%,rgba(255,255,255,.26) 50%,transparent 70%);
    transform:translateX(-120%); transition:transform .65s cubic-bezier(.2,.7,.3,1); pointer-events:none}
  .btn:hover::before{transform:translateX(120%)}

  /* --- FAB de WhatsApp --- */
  .wa-fab .ico{transition:transform .38s cubic-bezier(.34,1.56,.64,1)}
  .wa-fab:hover .ico{transform:scale(1.1) rotate(-6deg)}

  /* --- Selector de tema --- */
  #thm{transition:transform .34s cubic-bezier(.34,1.56,.64,1), box-shadow .35s}
  #thm:hover{transform:scale(1.06)}
}
@media (prefers-reduced-motion:reduce){ .btn::before{display:none} }

/* ===== Cursor: luz exterior, sin desenfocar el contenido ===== */
@media (hover:hover) and (pointer:fine){
  #ikring{
    -webkit-backdrop-filter:none!important; backdrop-filter:none!important;
    background:none!important;
    border:1.5px solid rgba(231,1,71,.5)!important;
    box-shadow:0 0 18px 2px rgba(231,1,71,.28), inset 0 0 12px rgba(255,170,74,.18)!important;
    transition:width .34s cubic-bezier(.2,.7,.3,1), height .34s cubic-bezier(.2,.7,.3,1),
      margin .34s cubic-bezier(.2,.7,.3,1), border-color .3s, box-shadow .34s, opacity .3s!important}
  body.ikhot #ikring{
    -webkit-backdrop-filter:none!important; backdrop-filter:none!important;
    background:radial-gradient(circle, rgba(255,170,74,.1) 0%, rgba(231,1,71,.06) 45%, transparent 70%)!important;
    border-color:rgba(255,170,74,.85)!important;
    box-shadow:0 0 34px 6px rgba(255,170,74,.4), 0 0 70px 16px rgba(231,1,71,.22), inset 0 0 22px rgba(255,170,74,.2)!important}
  body.ikdown #ikring{box-shadow:0 0 22px 3px rgba(255,170,74,.5), inset 0 0 14px rgba(255,170,74,.26)!important}
  #ikcur{box-shadow:0 0 12px 2px rgba(231,1,71,.55)}
  body.ikhot #ikcur{box-shadow:0 0 16px 3px rgba(255,170,74,.7)}
}

/* ===== Luz del cursor sobre las tarjetas ===== */
@media (hover:hover) and (pointer:fine){
  .card,.prod,.func,.fcard,.agent,.bcard,.step,.invc,.svcx,.iad-item,.mv-card,.model,.plan,
  .kpibox,.sc,.aw,.tr,.tst,.cs,.mt-card,.acard,.pcard-wrap,.chat{position:relative; isolation:isolate}
  .card::before,.prod::before,.func::before,.fcard::before,.agent::before,.bcard::before,.step::before,
  .invc::before,.svcx::before,.iad-item::before,.mv-card::before,.model::before,.plan::before,
  .kpibox::before,.sc::before,.aw::before,.tr::before,.tst::before,.cs::before,.mt-card::before,
  .acard::before,.chat::before{
    content:""; position:absolute; inset:0; border-radius:inherit; z-index:0; pointer-events:none;
    opacity:0; transition:opacity .45s cubic-bezier(.2,.7,.3,1);
    background:radial-gradient(340px circle at var(--mx,50%) var(--my,50%),
      rgba(231,1,71,.13) 0%, rgba(255,170,74,.08) 34%, transparent 66%)}
  .card:hover::before,.prod:hover::before,.func:hover::before,.fcard:hover::before,.agent:hover::before,
  .bcard:hover::before,.step:hover::before,.invc:hover::before,.svcx:hover::before,.iad-item:hover::before,
  .mv-card:hover::before,.model:hover::before,.plan:hover::before,.kpibox:hover::before,.sc:hover::before,
  .aw:hover::before,.tr:hover::before,.tst:hover::before,.cs:hover::before,.mt-card:hover::before,
  .acard:hover::before,.chat:hover::before{opacity:1}
  /* Sobre fondos oscuros la luz es más cálida y visible */
  .card.dk::before,.prod.dk::before,.invc.dk::before,.agent.count::before,.model.dk::before,
  .plan.hot::before,.fcard.tier.hot::before,.mv-card::before,.iad-item::before,.sc::before,
  .aw::before,.mt-card::before{
    background:radial-gradient(360px circle at var(--mx,50%) var(--my,50%),
      rgba(255,170,74,.2) 0%, rgba(231,1,71,.12) 36%, transparent 68%)}
  /* El contenido se mantiene por encima de la luz */
  .card>*,.prod>*,.func>*,.fcard>*,.agent>*,.bcard>*,.step>*,.invc>*,.svcx>*,.iad-item>*,
  .mv-card>*,.model>*,.plan>*,.kpibox>*,.sc>*,.aw>*,.tr>*,.tst>*,.cs>*,.mt-card>*,
  .acard>*,.chat>*{position:relative; z-index:1}
}

/* ===== Contraste del botón Contáctanos ===== */
header nav .btn-dark{background:#fff!important; color:var(--ink)!important;
  box-shadow:0 6px 18px -8px rgba(0,0,0,.5)!important; font-weight:800}
header nav .btn-dark:hover{background:var(--grad)!important; color:#fff!important;
  box-shadow:0 14px 32px -10px rgba(231,1,71,.65)!important}
header.scrolled nav .btn-dark{background:var(--ink)!important; color:#fff!important;
  box-shadow:0 6px 18px -8px rgba(19,17,23,.4)!important}
header.scrolled nav .btn-dark:hover{background:var(--grad)!important; color:#fff!important}
header nav .btn-dark .ico{color:currentColor}

@media (max-width:960px){
  .stage .panel{max-width:100%; overflow:hidden}
  .tabs{flex-wrap:wrap; row-gap:2px}
  .tab{font-size:13px!important; padding:8px 11px!important}
  .kpis{flex-wrap:wrap; gap:18px 24px!important}
  .kpi .n{font-size:26px!important}
  .dm-body{padding:20px!important}
  .dm-top{padding:18px 20px 0!important}
  .tabs{padding:14px 20px 0!important}
}

.hero-vid{opacity:0; transition:opacity .6s ease}
.hero-vid.ready{opacity:1}
.hero{background-image:url("/assets/hero-poster.jpg"); background-size:cover; background-position:center}
body.tp .hero{filter:none}

/* Modal de video */
/* Oculto por clase, no por [hidden]: el runtime no conserva los atributos booleanos vacíos. */
.vm{position:fixed; inset:0; z-index:120; display:none; place-items:center; padding:clamp(14px,4vw,48px)}
.vm.show{display:grid}
.vm-veil{position:absolute; inset:0; background:rgba(11,9,16,.74);
  -webkit-backdrop-filter:blur(18px) saturate(1.3); backdrop-filter:blur(18px) saturate(1.3);
  opacity:0; transition:opacity .34s cubic-bezier(.2,.7,.3,1); cursor:pointer}
.vm.on .vm-veil{opacity:1}
.vm-panel{position:relative; width:min(1100px,100%); border-radius:var(--r-xl); overflow:hidden;
  background:#0b0910; box-shadow:0 40px 100px -32px rgba(0,0,0,.75), inset 0 0 0 1px rgba(255,255,255,.12);
  opacity:0; transform:translateY(18px) scale(.985);
  transition:opacity .34s cubic-bezier(.2,.7,.3,1), transform .34s cubic-bezier(.2,.7,.3,1)}
.vm.on .vm-panel{opacity:1; transform:none}
.vm-panel video{display:block; width:100%; height:auto; aspect-ratio:16/9; background:#000}
.vm-close{position:absolute; top:clamp(10px,1.4vw,16px); right:clamp(10px,1.4vw,16px); z-index:2;
  width:42px; height:42px; padding:0; border:none; border-radius:100px; cursor:pointer;
  display:inline-flex; align-items:center; justify-content:center; color:#fff;
  background:rgba(255,255,255,.14); -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.3); transition:background .25s, transform .25s}
.vm-close:hover{background:rgba(255,255,255,.26); transform:translateY(-2px)}
.vm-close .ico{width:18px; height:18px}
body.vmodal-open{overflow:hidden; padding-right:var(--sbw,0px)}
body.vmodal-open header{padding-right:var(--sbw,0px)}
@media (max-width:700px){.vm-panel{border-radius:var(--r-lg)}}
@media (prefers-reduced-motion:reduce){.vm-veil,.vm-panel{transition:none}}
</style>
