.func h4{font-size:19px; font-weight:800; letter-spacing:-.02em} .func p{font-size:14px; color:var(--ink-soft); margin-top:6px}
.eye{margin-top:16px; background:var(--dark); color:#fff; border-radius:var(--r-xl); padding:clamp(32px,4.5vw,52px); display:grid; grid-template-columns:1fr 1fr; gap:clamp(28px,4vw,52px); align-items:center; box-shadow:var(--sh-lg)}
.eye .tag{font-size:12px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--mag-lt); display:inline-flex; align-items:center; gap:9px}
