---
const WP_GRAPHQL_ENDPOINT = import.meta.env.WP_GRAPHQL_ENDPOINT || "https://cms.interkont.co/graphql";

const QUERY = `
  query HomePage {
    page(id: "home", idType: URI) {
      title
      seo { title metaDesc metaRobotsNoindex }
      editorBlocks(flat: false) {
        __typename
        ... on CoreHeading { attributes { content level } }
        ... on CoreParagraph { attributes { content } }
      }
    }
  }
`;

let blocks = [];
let seo = null;
try {
  const res = await fetch(WP_GRAPHQL_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: QUERY }),
  });
  const json = await res.json();
  blocks = (json?.data?.page?.editorBlocks ?? []).map((b) => b.attributes?.content ?? "");
  seo = json?.data?.page?.seo ?? null;
} catch (err) {
  console.error("No se pudo leer WPGraphQL para /:", err);
}

const pageTitle = seo?.title || "Interkont — Claridad total sobre cada peso público";
const pageDescription = seo?.metaDesc || "Software GovTech para el control de la inversión pública: supervisión de obras y contratos, trazabilidad y datos para decidir mejor.";
const noindex = seo?.metaRobotsNoindex === "noindex";
