.avail{display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:24px}
.avail>span:first-child{font-size:13px; font-weight:700; color:var(--ink-soft)}
.ac{display:inline-flex; align-items:center; gap:8px; font-size:14px; font-weight:700; background:#fff; box-shadow:inset 0 0 0 1px var(--line); padding:9px 16px; border-radius:100px}
