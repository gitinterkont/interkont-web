<script is:inline type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  componentDidMount() { this.init(); }
  componentDidUpdate() { this.applyTheme(); if (this._redraw) this._redraw(); if (this._cxPaint) this._cxPaint(); if (this._tickAll) this._tickAll(); }
  applyTheme() {
    const t = localStorage.getItem('ik-theme') === 'purple';
    document.body.classList.toggle('tp', t);
    const b = document.getElementById('thm');
    if (b) b.setAttribute('data-theme', t ? 'purple' : 'original');
    document.documentElement.classList.add('notrans');
    void document.body.offsetWidth;
    setTimeout(() => document.documentElement.classList.remove('notrans'), 60);
  }
  init() {

    (() => {
      // Modal de video: lo abren los CTA "Conócenos" ([data-video]).
      const modal = () => document.getElementById('vmodal');
      const media = () => document.getElementById('vmodal-video');
      const hero = () => document.getElementById('herovid');
      let opener = null;

      const open = (trigger) => {
        const m = modal(), v = media();
        if (!m || !v || m.classList.contains('show')) return;
        opener = trigger;
        document.documentElement.style.setProperty('--sbw', (innerWidth - document.documentElement.clientWidth) + 'px');
        m.classList.add('show');
        void m.offsetWidth;
        m.classList.add('on');
        v.controls = true;
        document.body.classList.add('vmodal-open');
        // El hero tiene un `tryPlay` atado al primer clic del documento, y abrir el modal
        // es justamente un clic: hay que pausarlo cuando ese ciclo ya terminó.
        const hv = hero();
        if (hv) requestAnimationFrame(() => hv.pause());
        v.currentTime = 0;
        // El clic es un gesto del usuario, así que puede sonar; si el navegador lo rechaza, va en silencio.
        v.play().catch(() => { v.muted = true; v.play().catch(() => {}); });
        const btn = m.querySelector('.vm-close');
        if (btn) btn.focus({ preventScroll: true });
      };

      const close = () => {
        const m = modal(), v = media();
        if (!m || !m.classList.contains('show')) return;
        m.classList.remove('on');
        document.body.classList.remove('vmodal-open');
        if (v) { v.pause(); v.currentTime = 0; }
        const hv = hero();
        if (hv) hv.play().catch(() => {});
        setTimeout(() => { m.classList.contains('on') || m.classList.remove('show'); }, 360);
        if (opener && opener.isConnected) opener.focus({ preventScroll: true });
        opener = null;
      };

      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        if (!el) return;
        const trigger = el.closest('[data-video]');
        if (trigger) { e.preventDefault(); open(trigger); return; }
        if (el.closest('[data-vm-close]')) close();
      });

      document.addEventListener('keydown', (e) => {
        const m = modal();
        if (!m || !m.classList.contains('show')) return;
        if (e.key === 'Escape') { close(); return; }
        if (e.key !== 'Tab') return;
        const f = m.querySelectorAll('.vm-close, video');
        if (!f.length) return;
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      });
    })();

    (() => {
      if (!matchMedia('(hover:hover) and (pointer:fine)').matches) return;
      const SEL = '.card,.prod,.func,.fcard,.agent,.bcard,.step,.invc,.svcx,.iad-item,.mv-card,.model,.plan,.kpibox,.sc,.aw,.tr,.tst,.cs,.mt-card,.acard,.chat';
      let last = null;
      addEventListener('mousemove', (e) => {
        const el = e.target instanceof Element ? e.target.closest(SEL) : null;
        if (el !== last && last) { last.style.removeProperty('--mx'); last.style.removeProperty('--my'); }
        last = el;
        if (!el) return;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
        el.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
      }, { passive: true });
    })();
    this._cx = 0;
    const cxTotal = () => document.querySelectorAll('.cx').length;
    this._cxPaint = () => {
      const slides = document.querySelectorAll('.cx');
      if (!slides.length) return;
      if (this._cx >= slides.length) this._cx = 0;
      slides.forEach((s, i) => s.classList.toggle('on', i === this._cx));
      document.querySelectorAll('[data-cxt]').forEach((b, i) => b.classList.toggle('on', i === this._cx));
    };
    const cxGo = (n) => { const t = cxTotal(); if (!t) return; this._cx = (n + t) % t; this._cxPaint(); };
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target : null;
      if (!el) return;
      const tab = el.closest('[data-cxt]');
      if (tab) { cxGo(+tab.dataset.cxt); this._cxAuto = 0; return; }
      if (el.closest('#cx-prev')) { cxGo(this._cx - 1); this._cxAuto = 0; }
      if (el.closest('#cx-next')) { cxGo(this._cx + 1); this._cxAuto = 0; }
    });
    this._cxAuto = 1;
    setInterval(() => {
      const box = document.getElementById('cxs');
      if (!this._cxAuto || !box) return;
      const r = box.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0 && !box.matches(':hover')) cxGo(this._cx + 1);
    }, 7000);
    this._cxPaint();

    this.applyTheme();
    const thm = document.getElementById('thm');
    if (thm) thm.addEventListener('click', () => {
      const next = localStorage.getItem('ik-theme') === 'purple' ? 'original' : 'purple';
      localStorage.setItem('ik-theme', next);
      this.applyTheme();
    });

    if (matchMedia('(hover:hover) and (pointer:fine)').matches && !matchMedia('(prefers-reduced-motion:reduce)').matches && !document.getElementById('ikcur')) {
      const dot = document.createElement('div'); dot.id = 'ikcur';
      const blur = document.createElement('div'); blur.id = 'ikring';
      document.body.append(blur, dot);
      addEventListener('mousedown', () => document.body.classList.add('ikdown'));
      addEventListener('mouseup', () => document.body.classList.remove('ikdown'));
      let mx = innerWidth / 2, my = innerHeight / 2, bx = mx, by = my, idle;
      addEventListener('mousemove', (e) => {
        if (!document.body.classList.contains('ikready')) { bx = mx = e.clientX; by = my = e.clientY; document.body.classList.add('ikready'); dot.style.opacity = '1'; blur.style.opacity = '1'; }
        mx = e.clientX; my = e.clientY;
        dot.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
        document.body.classList.add('ikmove');
        clearTimeout(idle); idle = setTimeout(() => document.body.classList.remove('ikmove'), 220);
        const el = e.target instanceof Element ? e.target : null;
        const t = el && el.closest('a,button,.tab,input,textarea,select,[role="button"],.card,.prod,.func,.fcard,.agent,.bcard,.mv-card,.iad-item,.step,.invc,.svcx,.sc,.plan,.model,.kpibox,svg,.chat,.mock,.scan,.panel,.pz');
        document.body.classList.toggle('ikhot', !!t);
      }, { passive: true });
      const loop = () => { bx += (mx - bx) * 0.16; by += (my - by) * 0.16; blur.style.transform = 'translate(' + bx + 'px,' + by + 'px)'; requestAnimationFrame(loop); };
      loop();
    }
    const reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
    const v = document.getElementById('herovid');
    if (v) {
      v.muted = true; v.defaultMuted = true; v.loop = true; v.playsInline = true; v.autoplay = true;
      v.setAttribute('muted', ''); v.setAttribute('loop', '');
      const tryPlay = () => v.play().catch(() => {});
      tryPlay();
      v.addEventListener('canplay', tryPlay, { once: true });
      document.addEventListener('click', tryPlay, { once: true });
    }
    const header = document.getElementById('header');
    const hero = document.querySelector('.hero');
    if (header && hero) {
      const onScroll = () => header.classList.toggle('scrolled', hero.getBoundingClientRect().bottom < 70);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
    const tog = document.getElementById('tog'), nav = document.getElementById('nav');
    if (tog && nav) {
      const setNav = (open) => document.body.classList.toggle('navopen', open);
      tog.addEventListener('click', () => setNav(!document.body.classList.contains('navopen')));
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element ? e.target : null;
        if (el && el.closest('#nav a')) setNav(false);
      });
      addEventListener('resize', () => setNav(false));
      setNav(false);
    }



    const DATA = [
      { k: ['$6.5M', '32.000+', '98.4%'], pts: [.35, .5, .42, .62, .55, .78, .68, .9, .82, 1] },
      { k: ['32.000+', '+1.240', '4 niveles'], pts: [.3, .42, .55, .48, .66, .6, .8, .74, .92, 1] },
      { k: ['30.000+', '98.4%', '1.240'], pts: [.5, .44, .6, .52, .7, .64, .82, .72, .88, .95] },
      { k: ['+412', '23 críticas', '89% resueltas'], pts: [.6, .75, .55, .82, .62, .9, .7, .95, .6, .85] }
    ];
    this._tab = 0;
    const drawChart = (pts) => {
      const line = document.getElementById('dcline'), areaEl = document.getElementById('dcarea');
      if (!line || !areaEl) return;
      const W = 520, H = 150, step = W / (pts.length - 1);
      let d = 'M0 ' + (H - pts[0] * (H - 22));
      pts.forEach((p, i) => { if (i > 0) d += ' L' + (i * step).toFixed(2) + ' ' + (H - p * (H - 22)).toFixed(2); });
      line.setAttribute('d', d);
      areaEl.setAttribute('d', d + ' L' + W + ' ' + H + ' L0 ' + H + ' Z');
    };
    const paint = () => {
      const i = this._tab, d = DATA[i];
      document.querySelectorAll('.tab').forEach((t, j) => t.classList.toggle('on', j === i));
      ['k1', 'k2', 'k3'].forEach((id, j) => { const el = document.getElementById(id); if (el) el.textContent = d.k[j]; });
      drawChart(d.pts);
    };
    this._redraw = () => { if (this._tab) paint(); };
    const setTab = (i) => { this._tab = i; paint(); };
    document.addEventListener('click', (e) => {
      const t = e.target.closest('.tab');
      if (t) setTab(+t.dataset.t);
    });
    paint();

    const track = document.getElementById('tablero');
    if (track) {
      const pieces = [...track.querySelectorAll('.pz')];
      const upd = () => {
        const total = track.offsetHeight - innerHeight, top = track.getBoundingClientRect().top;
        let p = Math.min(Math.max(-top / total, 0), 1);
        const e = 1 - Math.pow(1 - p, 2);
        pieces.forEach(pc => {
          const ix = +pc.dataset.ix, iy = +pc.dataset.iy, ir = +pc.dataset.ir;
          pc.style.opacity = Math.min(1, e * 1.5);
          pc.style.transform = 'translate(' + (ix * (1 - e)) + 'px,' + (iy * (1 - e)) + 'px) rotate(' + (ir * (1 - e)) + 'deg) scale(' + (0.92 + 0.08 * e) + ')';
        });
      };
      if (reduce || matchMedia('(max-width:960px)').matches) {
        pieces.forEach(pc => { pc.style.opacity = 1; pc.style.transform = 'none'; });
      } else {
        window.addEventListener('scroll', upd, { passive: true });
        window.addEventListener('resize', upd);
        upd();
      }
    }

    const fmt = (v) => Math.round(v).toLocaleString('es-CO');
    document.querySelectorAll('[data-count]').forEach(el => {
      const target = +el.dataset.count, suf = el.dataset.suffix || '';
      const cIO = new IntersectionObserver(e => {
        if (!e[0].isIntersecting) return;
        cIO.disconnect();
        if (reduce) { el.textContent = fmt(target) + suf; return; }
        const dur = 1400, t0 = performance.now();
        const tick = (now) => {
          const p = Math.min((now - t0) / dur, 1), e2 = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(target * e2) + (p === 1 ? suf : '');
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }, { threshold: .5 });
      cIO.observe(el);
    });

    const pd = [35, 58, 45, 72, 52, 85], prog = document.getElementById('prog');
    if (prog) {
      pd.forEach(() => { const s = document.createElement('span'); prog.appendChild(s); });
      const pIO = new IntersectionObserver(e => {
        if (e[0].isIntersecting) {
          prog.querySelectorAll('span').forEach((s, i) => setTimeout(() => s.style.height = pd[i] + '%', i * 80));
          pIO.disconnect();
        }
      }, { threshold: .4 });
      pIO.observe(prog);
    }
  }
}
</script>
</body>
</html>
