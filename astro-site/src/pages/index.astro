header.scrolled .hbar{background:none; padding-top:10px; padding-bottom:10px}
header.scrolled .hbar::before{background:rgba(255,255,255,.82); -webkit-backdrop-filter:blur(20px) saturate(1.4); backdrop-filter:blur(20px) saturate(1.4);
  box-shadow:inset 0 0 0 1px rgba(19,17,23,.07), 0 16px 40px -22px rgba(19,17,23,.4)}
header.scrolled nav a{color:var(--ink-soft)} header.scrolled nav a:hover{color:var(--ink)}

/* === Cursor: punto + anillo con blur === */
@media (hover:hover) and (pointer:fine){
