.stat-band{position:relative; overflow:hidden; background:var(--dark); color:#fff; border-radius:var(--r-xl); padding:clamp(34px,5vw,56px); margin-top:44px; display:grid; grid-template-columns:repeat(3,1fr); box-shadow:var(--sh-lg)}
.stat-band::before{content:""; position:absolute; width:560px; height:560px; right:-160px; bottom:-260px; background:radial-gradient(circle, color-mix(in srgb, var(--mag) 42%, transparent), transparent 66%); filter:blur(24px)}
.sb{position:relative; z-index:2; padding:6px 30px}
.sb+.sb{border-left:1px solid rgba(255,255,255,.13)}
.sb .n{font-size:clamp(42px,6vw,70px); font-weight:900; letter-spacing:-.045em; line-height:1}
.sb .n .u{color:var(--mag-lt)}
.sb .l{font-size:12.5px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; color:rgba(255,255,255,.55); margin-top:12px}
.func-head{display:flex; align-items:end; justify-content:space-between; gap:30px; flex-wrap:wrap; margin-top:clamp(56px,7vw,88px)}
