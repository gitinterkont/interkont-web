.rv{opacity:1; transform:none}
@supports (animation-timeline: view()){
  @media (prefers-reduced-motion:no-preference){
    @keyframes rv-in{from{opacity:0; transform:translateY(28px)} to{opacity:1; transform:none}}
    .rv{animation:rv-in .8s cubic-bezier(.2,.7,.3,1) forwards; animation-timeline:view(); animation-range:entry 0% entry 55%}
  }
}

@media (max-width:960px){
  .split,.cards,.prods{grid-template-columns:1fr; gap:14px}
  .stat-band{grid-template-columns:1fr; gap:26px; padding:32px} .sb{padding:0} .sb+.sb{border-left:none; border-top:1px solid rgba(255,255,255,.13); padding-top:24px}
  .funcs{grid-template-columns:1fr} .eye{grid-template-columns:1fr}
  nav{position:fixed; inset:0 0 0 auto; width:min(80vw,300px); flex-direction:column; justify-content:center; background:#fff; transform:translateX(100%); transition:.4s; padding:40px; gap:24px; z-index:90}
  nav.open{transform:none} nav a{color:var(--ink-soft)} .menu-tog{display:block; z-index:95}
  .hero-content{max-width:none}
  .dash-track{height:auto} .dash-sticky{position:static; height:auto; padding:10px 0 30px}
  .stage{width:100%; height:auto; display:flex; flex-direction:column; gap:14px}
  .pz{position:static; opacity:1; transform:none; width:auto}
}
@media (prefers-reduced-motion:reduce){*{animation:none;transition:none}.rv{opacity:1;transform:none}.pz{opacity:1;transform:none}}

/* === Gradiente de marca === */
:root{ --grad:linear-gradient(92deg,var(--g1) 0%,var(--g2) 100%); --grad-r:linear-gradient(120deg,var(--g1) 0%,var(--g2) 100%); }
