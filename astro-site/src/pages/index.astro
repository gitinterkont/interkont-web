.iad-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:14px; margin-bottom:38px}
.iad-item{background:var(--dark-2); border-radius:var(--r); padding:22px; transition:transform .3s}
.iad-item:hover{transform:translateY(-5px)}
.iad-item .ii{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:color-mix(in srgb, var(--mag) 18%, transparent);color:var(--mag-lt);margin-bottom:13px}
