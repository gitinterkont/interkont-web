header .hbar{position:relative; margin:14px auto 0; padding:10px 14px 10px 24px; border-radius:100px; background:none;
  max-width:calc(1360px - 2*clamp(16px,2.6vw,34px)); width:calc(100% - 2*clamp(16px,2.6vw,34px)); transition:.35s}
header .hbar::before{content:""; position:absolute; inset:0; z-index:-1; border-radius:inherit;
  background:rgba(20,17,26,.42); -webkit-backdrop-filter:blur(18px) saturate(1.3); backdrop-filter:blur(18px) saturate(1.3);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.14), 0 18px 40px -22px rgba(0,0,0,.7); transition:.35s}
