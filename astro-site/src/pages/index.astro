.funcs{display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:34px}
.func{background:#fff; border-radius:var(--r-lg); padding:28px; box-shadow:var(--sh); transition:transform .35s, box-shadow .35s}
