.eye-caps{list-style:none; margin-top:22px; display:flex; flex-direction:column; gap:12px}
.eye-caps li{display:flex; gap:13px; align-items:flex-start; font-size:14.5px; color:rgba(255,255,255,.82)}
.eye-caps .ei{width:36px;height:36px;border-radius:11px;flex:none;background:color-mix(in srgb, var(--mag) 18%, transparent);color:var(--mag-lt);display:grid;place-items:center}
.eye-caps .ei .ico{width:18px;height:18px}
.scan{position:relative; aspect-ratio:4/3; border-radius:var(--r-lg); overflow:hidden; background:radial-gradient(130% 120% at 20% 10%, #2b2634, #14121a); box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.scan .grid{position:absolute; inset:0; background-image:linear-gradient(rgba(255,255,255,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.05) 1px,transparent 1px); background-size:34px 34px}
.scan .line{position:absolute; left:0; right:0; height:2px; background:linear-gradient(90deg,transparent,var(--mag-lt),transparent); box-shadow:0 0 16px var(--mag-lt); animation:scanmove 3.4s ease-in-out infinite}
@keyframes scanmove{0%,100%{top:8%}50%{top:90%}}
.box{position:absolute; border:2px solid var(--mag-lt); border-radius:8px; box-shadow:0 0 0 1px rgba(0,0,0,.3)}
.box .bl{position:absolute; top:-11px; left:-2px; background:var(--mag); color:#fff; font-size:9.5px; font-weight:700; padding:2px 7px; border-radius:5px; white-space:nowrap}
.iad{margin:0 clamp(16px,2.6vw,34px); border-radius:var(--r-xl); background:var(--dark); color:#fff; padding:clamp(40px,6vw,64px); position:relative; overflow:hidden}
.iad::before{content:""; position:absolute; width:520px; height:520px; right:-140px; top:-160px; background:radial-gradient(circle, color-mix(in srgb, var(--mag) 40%, transparent), transparent 66%); filter:blur(20px)}
