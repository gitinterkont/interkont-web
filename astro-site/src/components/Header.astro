---
const { isHome = false } = Astro.props;
const logoHref = isHome ? "#" : "/";

const WP_GRAPHQL_ENDPOINT = import.meta.env.WP_GRAPHQL_ENDPOINT || "https://cms.interkont.co/graphql";

const MENU_QUERY = `
  query PrimaryMenu {
    menuItems(where: { location: PRIMARY }, first: 30) {
      nodes {
        id
        label
        url
        target
        description
        cssClasses
        parentId
        order
      }
    }
  }
`;

// WordPress no tiene un campo nativo para "ícono" en un ítem de menú, así
// que el ícono del submenú "Soluciones" se resuelve por la ruta del enlace.
// Cualquier ruta nueva que no esté aquí usa el ícono genérico de respaldo.
const ICONS_BY_PATH = {
  "/cobra": "i-activity",
  "/panal": "i-users",
  "/ik-labs": "i-sparkles",
};
const DEFAULT_ICON = "i-grid";
const iconFor = (url) => {
  const path = (url || "").replace(/\/$/, "");
  return ICONS_BY_PATH[path] ?? DEFAULT_ICON;
};

// Se usa si el menú "Menú principal" todavía no existe en WordPress, o si
// la consulta a WPGraphQL falla -- así el header nunca se queda vacío.
const FALLBACK_LINKS = [
  { id: "fallback-home", label: "Interkont", url: "/", target: null, cssClasses: [] },
  { id: "fallback-productos", label: "Nuestros productos", url: "/productos/", target: null, cssClasses: [] },
  { id: "fallback-blog", label: "Blog", url: "/blog/", target: null, cssClasses: [] },
  { id: "fallback-catalogo", label: "Catálogo IAD", url: "/catalogo-iad/", target: null, cssClasses: [] },
  { id: "fallback-cta", label: "Contáctanos", url: "/#final", target: null, cssClasses: ["btn", "btn-dark"] },
];
const FALLBACK_DROPDOWN = [
  { id: "fallback-cobra", label: "COBRA", url: "/cobra/", description: "Monitoreo de inversión pública en tiempo real" },
  { id: "fallback-panal", label: "PANAL", url: "/panal/", description: "Asistencia a necesidades de ayudas localizadas" },
  { id: "fallback-ik-labs", label: "IK Labs", url: "/ik-labs/", description: "Agentes de inteligencia artificial" },
];

let allItems = [];
try {
  const res = await fetch(WP_GRAPHQL_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: MENU_QUERY }),
  });
  const json = await res.json();
  allItems = json?.data?.menuItems?.nodes ?? [];
} catch (err) {
  console.error("No se pudo leer el menú principal de WPGraphQL:", err);
}

const byOrder = (a, b) => (a.order ?? 0) - (b.order ?? 0);
const topLevel = allItems.filter((item) => !item.parentId).sort(byOrder);

// El ítem "Soluciones" (por label, sin importar mayúsculas) actúa como
// disparador del dropdown -- sus hijos anidados en Apariencia > Menús son
// las tarjetas del submenú. El resto de ítems de primer nivel son enlaces
// normales del nav.
const solucionesNode = topLevel.find((item) => item.label?.trim().toLowerCase() === "soluciones");

const links = topLevel.length > 0
  ? topLevel.filter((item) => item !== solucionesNode)
  : FALLBACK_LINKS;

let dropdownItems = solucionesNode
  ? allItems.filter((item) => item.parentId === solucionesNode.id).sort(byOrder)
  : [];
if (dropdownItems.length === 0) dropdownItems = FALLBACK_DROPDOWN;

const [firstLink, ...restLinks] = links;
const ctaStyle = (item) => ((item.cssClasses ?? []).includes("btn-dark") ? "padding:11px 22px" : undefined);
---

<header id="header">
  <div class="hbar">
    <a href={logoHref} class="logo" aria-label="Interkont"><svg class="logo-w" viewBox="0 0 791 185"><use href="#ik-white"></use></svg><svg class="logo-c" viewBox="0 0 777 182"><use href="#ik-color"></use></svg></a>
    <nav id="nav">
      {firstLink && (
        <a href={firstLink.url} class={(firstLink.cssClasses ?? []).join(" ") || undefined} style={ctaStyle(firstLink)} target={firstLink.target || undefined} rel={firstLink.target === "_blank" ? "noopener noreferrer" : undefined}>{firstLink.label}</a>
      )}
      <div class="nav-drop">
        <button class="nav-dropbtn" type="button">Soluciones <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></button>
        <div class="drop">
          {dropdownItems.map((item) => (
            <a href={item.url}><span class="di"><svg class="ico"><use href={`#${iconFor(item.url)}`}></use></svg></span><span><span class="dt">{item.label}</span><span class="dd">{item.description}</span></span></a>
          ))}
        </div>
      </div>
      {restLinks.map((item) => (
        <a href={item.url} class={(item.cssClasses ?? []).join(" ") || undefined} style={ctaStyle(item)} target={item.target || undefined} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>
      ))}
    </nav>
    <button class="thm" id="thm" type="button" aria-label="Cambiar color de marca" title="Cambiar color de marca"><span class="sw sw-a"></span><span class="sw sw-b"></span></button>
    <button class="menu-tog" id="tog" aria-label="Menú">≡</button>
  </div>
</header>
