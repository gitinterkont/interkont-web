---
const { isHome = false, lang = "es", altHref = null } = Astro.props;
const isEn = lang === "en";
const logoHref = isHome ? "#" : isEn ? "/en/" : "/";
const esHref = isEn ? (altHref ?? "/") : null;
const enHref = isEn ? null : (altHref ?? "/en/");

const WP_GRAPHQL_ENDPOINT = import.meta.env.WP_GRAPHQL_ENDPOINT || "https://cms.interkont.co/graphql";

const MENU_QUERY = `
  query PrimaryMenu {
    menuItems(where: { location: PRIMARY }, first: 30) {
      nodes {
        id
        label
        url
        target
        description
        cssClasses
        parentId
        order
      }
    }
  }
`;

// WordPress no tiene un campo nativo para "ícono" en un ítem de menú, así
// que el ícono del submenú "Soluciones" se resuelve por la ruta del enlace.
// Cualquier ruta nueva que no esté aquí usa el ícono genérico de respaldo.
const ICONS_BY_PATH = {
  "/cobra": "i-activity",
  "/panal": "i-users",
  "/ik-labs": "i-sparkles",
};
const DEFAULT_ICON = "i-grid";
const iconFor = (url) => {
  const path = (url || "").replace(/\/$/, "");
  return ICONS_BY_PATH[path] ?? DEFAULT_ICON;
};

// Se usa si el menú "Menú principal" todavía no existe en WordPress, o si
// la consulta a WPGraphQL falla -- así el header nunca se queda vacío.
const FALLBACK_LINKS = [
  { id: "fallback-home", label: "Interkont", url: "/", target: null, cssClasses: [] },
  { id: "fallback-productos", label: "Nuestros productos", url: "/productos/", target: null, cssClasses: [] },
  { id: "fallback-blog", label: "Blog", url: "/blog/", target: null, cssClasses: [] },
  { id: "fallback-catalogo", label: "Catálogo IAD", url: "/catalogo-iad/", target: null, cssClasses: [] },
  { id: "fallback-cta", label: "Contáctanos", url: "/#final", target: null, cssClasses: ["btn", "btn-dark"] },
];
const FALLBACK_DROPDOWN = [
  { id: "fallback-cobra", label: "COBRA", url: "/cobra/", description: "IA-first · Monitoreo de inversión pública en tiempo real" },
  { id: "fallback-panal", label: "PANAL", url: "/panal/", description: "IA-first · Asistencia a necesidades de ayudas localizadas" },
  { id: "fallback-ik-labs", label: "IK Labs", url: "/ik-labs/", description: "Agentes de inteligencia artificial" },
];

const EN_LINKS = [
  { id: "en-home", label: "Interkont", url: "/en/", target: null, cssClasses: [] },
  { id: "en-productos", label: "Our products", url: "/en/productos/", target: null, cssClasses: [] },
  { id: "en-blog", label: "Blog", url: "/en/blog/", target: null, cssClasses: [] },
  { id: "en-catalogo", label: "IAD Catalog", url: "/en/catalogo-iad/", target: null, cssClasses: [] },
  { id: "en-cta", label: "Contact us", url: "/en/#final", target: null, cssClasses: ["btn", "btn-dark"] },
];
const EN_DROPDOWN = [
  { id: "en-cobra", label: "COBRA", url: "/en/cobra/", description: "AI-first · Real-time public investment monitoring" },
  { id: "en-panal", label: "PANAL", url: "/en/panal/", description: "AI-first · Targeted social aid management" },
  { id: "en-ik-labs", label: "IK Labs", url: "/en/ik-labs/", description: "Artificial intelligence agents" },
];

let allItems = [];
try {
  if (isEn) throw new Error("menu EN fijo");
  const res = await fetch(WP_GRAPHQL_ENDPOINT, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ query: MENU_QUERY }),
  });
  const json = await res.json();
  allItems = json?.data?.menuItems?.nodes ?? [];
} catch (err) {
  if (!isEn) console.error("No se pudo leer el menú principal de WPGraphQL:", err);
}

const byOrder = (a, b) => (a.order ?? 0) - (b.order ?? 0);
const topLevel = allItems.filter((item) => !item.parentId).sort(byOrder);

// El ítem "Soluciones" (por label, sin importar mayúsculas) actúa como
// disparador del dropdown -- sus hijos anidados en Apariencia > Menús son
// las tarjetas del submenú. El resto de ítems de primer nivel son enlaces
// normales del nav.
const solucionesNode = topLevel.find((item) => item.label?.trim().toLowerCase() === "soluciones");

const links = isEn
  ? EN_LINKS
  : topLevel.length > 0
    ? topLevel.filter((item) => item !== solucionesNode)
    : FALLBACK_LINKS;

let dropdownItems = solucionesNode
  ? allItems.filter((item) => item.parentId === solucionesNode.id).sort(byOrder)
  : [];
if (isEn) dropdownItems = EN_DROPDOWN;
else if (dropdownItems.length === 0) dropdownItems = FALLBACK_DROPDOWN;

const [firstLink, ...restLinks] = links;
const ctaStyle = (item) => ((item.cssClasses ?? []).includes("btn-dark") ? "padding:11px 22px" : undefined);
const FLAG_ES = '<svg viewBox="0 0 30 20" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="30" height="20" fill="#C60B1E"/><rect y="5" width="30" height="10" fill="#FFC400"/></svg>';
const FLAG_EN = '<svg viewBox="0 0 30 20" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect y="0.00" width="30" height="1.54" fill="#B22234"/><rect y="3.08" width="30" height="1.54" fill="#B22234"/><rect y="6.15" width="30" height="1.54" fill="#B22234"/><rect y="9.23" width="30" height="1.54" fill="#B22234"/><rect y="12.31" width="30" height="1.54" fill="#B22234"/><rect y="15.38" width="30" height="1.54" fill="#B22234"/><rect y="18.46" width="30" height="1.54" fill="#B22234"/><rect width="12.5" height="10.77" fill="#3C3B6E"/></svg>';
---

<header id="header">
  <div class="hbar">
    <a href={logoHref} class="logo" aria-label="Interkont"><svg class="logo-w" viewBox="0 0 791 185"><use href="#ik-white"></use></svg><svg class="logo-c" viewBox="0 0 777 182"><use href="#ik-color"></use></svg></a>
    <nav id="nav">
      {firstLink && (
        <a href={firstLink.url} class={(firstLink.cssClasses ?? []).join(" ") || undefined} style={ctaStyle(firstLink)} target={firstLink.target || undefined} rel={firstLink.target === "_blank" ? "noopener noreferrer" : undefined}>{firstLink.label}</a>
      )}
      <div class="nav-drop">
        <button class="nav-dropbtn" type="button">{isEn ? "Solutions" : "Soluciones"} <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg></button>
        <div class="drop">
          {dropdownItems.map((item) => (
            <a href={item.url}><span class="di"><svg class="ico"><use href={`#${iconFor(item.url)}`}></use></svg></span><span><span class="dt">{item.label}</span><span class="dd">{item.description}</span></span></a>
          ))}
        </div>
      </div>
      {restLinks.map((item) => (
        <a href={item.url} class={(item.cssClasses ?? []).join(" ") || undefined} style={ctaStyle(item)} target={item.target || undefined} rel={item.target === "_blank" ? "noopener noreferrer" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="lang" role="group" aria-label={isEn ? "Language" : "Idioma"}>
      <a href={isEn ? esHref : "#"} hreflang="es" lang="es" class={isEn ? undefined : "on"} aria-current={isEn ? undefined : "page"}><span class="fl" set:html={FLAG_ES}></span><span class="c">ES</span></a>
      <a href={isEn ? "#" : enHref} hreflang="en" lang="en" class={isEn ? "on" : undefined} aria-current={isEn ? "page" : undefined}><span class="fl" set:html={FLAG_EN}></span><span class="c">EN</span></a>
    </div>
    <button class="thm" id="thm" type="button" aria-label={isEn ? "Change brand color" : "Cambiar color de marca"} title={isEn ? "Change brand color" : "Cambiar color de marca"}><span class="sw sw-a"></span><span class="sw sw-b"></span></button>
    <button class="menu-tog" id="tog" aria-label={isEn ? "Menu" : "Menú"}>≡</button>
  </div>
</header>

<style is:global>
.hbar nav{margin-left:auto}
.lang{display:flex; align-items:center; gap:4px; margin-left:20px; padding:4px; border-radius:100px; background:rgba(255,255,255,.14); box-shadow:inset 0 0 0 1px rgba(255,255,255,.26); flex-shrink:0}
.lang a{display:flex; align-items:center; gap:8px; font-family:var(--sans); font-size:12.5px; font-weight:800; letter-spacing:.05em; line-height:1; padding:4px 12px 4px 4px; border-radius:100px; color:rgba(255,255,255,.85); transition:background .25s, color .25s}
.lang a:hover{background:rgba(255,255,255,.16); color:#fff}
.lang a.on{background:#fff; color:var(--ink); box-shadow:0 2px 8px -2px rgba(19,17,23,.35)}
.lang .fl{width:24px; height:24px; border-radius:50%; overflow:hidden; flex-shrink:0; display:block; box-shadow:0 0 0 1.5px rgba(19,17,23,.12); opacity:.72; transition:opacity .25s}
.lang .fl svg{display:block; width:100%; height:100%}
.lang a:hover .fl,.lang a.on .fl{opacity:1}
header.scrolled .lang{background:rgba(19,17,23,.05); box-shadow:inset 0 0 0 1px rgba(19,17,23,.12)}
header.scrolled .lang a{color:var(--ink-soft)}
header.scrolled .lang a:hover{background:rgba(19,17,23,.07); color:var(--ink)}
header.scrolled .lang a.on{background:var(--ink); color:#fff; box-shadow:0 2px 8px -2px rgba(19,17,23,.4)}
@media (max-width:960px){ .lang{margin:0 12px 0 auto} .lang a{padding-right:10px} }
@media (max-width:420px){ .lang a{gap:0; padding:4px} .lang a .c{display:none} }
</style>
